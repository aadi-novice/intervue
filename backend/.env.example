ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://intervue:intervue123@localhost:5432/intervue_db
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# Object storage (MinIO locally; AWS S3 / R2 in prod)
STORAGE_BACKEND=s3
S3_BUCKET=intervue-dev
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# LLM
OPENAI_API_KEY=
MODEL_RESUME_PARSE=gpt-4.1-mini
MODEL_ANALYSIS=gpt-4.1-mini
MODEL_RANK=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small

REDIS_URL=redis://localhost:6379/0

# Security (generate real keys outside dev: RS256 PEMs, Fernet key)
INTERNAL_HMAC_SECRET=dev-internal-secret
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
COOKIE_SECURE=false
# /auth when the browser talks to the API directly; /api/auth behind the Next.js /api proxy
REFRESH_COOKIE_PATH=/api/auth
TOKEN_ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

EMAIL_BACKEND=console
EMAIL_FROM=Intervue <no-reply@intervue.local>
SMTP_HOST=localhost
SMTP_PORT=1025

# Backend URL as seen from bot containers + transcriber
INTERNAL_API_URL=http://host.docker.internal:8000
BOT_LAUNCHER=docker
BOT_DOCKER_NETWORK=
ECS_CLUSTER=
ECS_TASK_DEFINITION=
ECS_SUBNETS=
ECS_SECURITY_GROUPS=
BOT_CONCURRENCY_PER_ORG=3
BOT_CONCURRENCY_GLOBAL=20
BOT_IMAGE=intervue-notetaker-bot:latest
TRANSCRIBER_MODE=local
TRANSCRIBER_URL=http://localhost:8100
TRANSCRIBER_API_KEY=dev-transcriber-key
TRANSCRIBER_CALLBACK_SECRET=dev-transcriber-secret

RANK_SHORTLIST_K=50
# Calendar auto-join (M6): reuses the Google/Microsoft OAuth clients above. Add redirect URIs
#   {PUBLIC_API_URL}/calendar/oauth/google/callback and .../microsoft/callback in each console.
# TOKEN_ENCRYPTION_KEY must be a Fernet key (python -c "from app.core.crypto import generate_key; print(generate_key())")
# Push notifications only activate when PUBLIC_API_URL is a public https URL; polling works regardless.
CALENDAR_SYNC_MINUTES=5
CALENDAR_WINDOW_DAYS=14
CALENDAR_PUSH_ENABLED=true
SENTRY_DSN=
LOG_LEVEL=INFO
