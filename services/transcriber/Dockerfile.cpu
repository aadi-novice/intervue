# CPU image (Render, small servers). Defaults to the `medium` model with int8.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH"

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /uvx /usr/local/bin/

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --extra api

COPY app ./app

RUN useradd --create-home --uid 10001 transcriber \
    && mkdir -p /models && chown transcriber /models
ENV HF_HOME=/models \
    WHISPER_DEVICE=cpu \
    WHISPER_MODEL=medium \
    WHISPER_COMPUTE_TYPE=int8 \
    PORT=8080

# Optional: bake the model into the image (build with --build-arg PRELOAD_MODEL=medium).
ARG PRELOAD_MODEL=""
RUN if [ -n "$PRELOAD_MODEL" ]; then \
      python -c "from huggingface_hub import snapshot_download; snapshot_download('Systran/faster-whisper-${PRELOAD_MODEL}')"; \
    fi \
    && chown -R transcriber /models

USER transcriber
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s \
  CMD curl -fsS http://localhost:8080/healthz || exit 1
CMD ["python", "-m", "app"]
