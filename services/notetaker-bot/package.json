{
  "name": "@intervue/notetaker-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Intervue notetaker bot: joins a meeting as a guest, records audio, observes speakers, reports to the backend.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:pool": "node dist/pool.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "tsc -p tsconfig.lint.json --noEmit"
  },
  "dependencies": {
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "playwright": "1.64.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
