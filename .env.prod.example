# Used by docker-compose.prod.yml (--env-file .env.prod, and loaded into backend/worker/beat as env_file).
# Generate secrets with:  openssl rand -hex 32
DOMAIN=intervue.example.com
POSTGRES_PASSWORD=change-me
BACKUP_KEEP_DAYS=14

# Object storage (no MinIO in prod): AWS S3 / Cloudflare R2 / Backblaze B2. Private bucket, no public access.
STORAGE_BACKEND=s3
S3_BUCKET=
S3_REGION=us-east-1
# Leave empty for AWS S3; set for R2/B2, e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Security
INTERNAL_HMAC_SECRET=
# RS256 PEM pair. Generate:  openssl genrsa 2048 | tee jwt.key | openssl rsa -pubout > jwt.pub
# Put PEMs on one line with literal \n if your env loader does not support multi-line values.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Fernet key:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# LLM
OPENAI_API_KEY=

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Email
EMAIL_BACKEND=smtp
EMAIL_FROM=Intervue <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Bots / transcriber
BOT_LAUNCHER=pool
BOT_IMAGE=intervue-notetaker-bot:latest
TRANSCRIBER_MODE=api
TRANSCRIBER_URL=
TRANSCRIBER_API_KEY=
TRANSCRIBER_CALLBACK_SECRET=

SENTRY_DSN=
LOG_LEVEL=INFO
